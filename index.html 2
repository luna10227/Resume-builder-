<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instant A4 Resume Builder Engine</title>
    <!-- Modern Tailwind CSS Delivery Engine -->
    <script src="https://jsdelivr.net"></script>
    <!-- High-Fidelity Client-Side PDF Compiler Engine -->
    <script src="https://cloudflare.com"></script>
    <style>
        /* Forces standard print typography anti-aliasing configurations */
        #resumeCanvas {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-900">

    <!-- Top Core Application Navigation Ecosystem -->
    <nav class="bg-slate-900 text-white border-b border-slate-800 px-6 py-4 sticky top-0 z-50 shadow-xs">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <span class="text-2xl">📄</span>
                <div>
                    <h1 class="text-lg font-bold tracking-tight leading-none text-white">GitResume Creator</h1>
                    <p class="text-xs text-slate-400 mt-1">Real-time Reactive HTML-to-PDF Engine</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="downloadPDF()" class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-sm px-5 py-2.5 rounded-lg transition duration-200 shadow-sm active:scale-98 cursor-pointer flex items-center gap-2">
                    <span>⬇️</span> Download Professional PDF
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Workspace Split Container -->
    <main class="max-w-7xl mx-auto my-6 px-4 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Side: Interactive Forms Panel Configuration (5 Columns) -->
        <section class="lg:col-span-5 bg-white p-6 rounded-xl border border-slate-200 shadow-xs space-y-6 max-h-[85vh] overflow-y-auto">
            <h2 class="text-lg font-bold text-slate-800 tracking-tight flex items-center gap-2 border-b border-slate-100 pb-3">
                ✍️ Input Professional Parameters
            </h2>
            
            <!-- Block 1: Contact Information Framework -->
            <div class="space-y-4">
                <h3 class="text-xs font-bold text-blue-600 tracking-wider uppercase">1. Personal Identity Details</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Full Name</label>
                        <input type="text" id="formName" placeholder="Alex Morgan" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Target Job Title</label>
                        <input type="text" id="formTitle" placeholder="Senior Systems Architect" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Email</label>
                        <input type="email" id="formEmail" placeholder="alex@domain.com" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-2.5 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Phone</label>
                        <input type="text" id="formPhone" placeholder="(555) 234-5678" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-2.5 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Location</label>
                        <input type="text" id="formLocation" placeholder="San Francisco, CA" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-2.5 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Professional Profile Summary</label>
                    <textarea id="formSummary" placeholder="Results-driven professional with 8+ years of dedicated expertise specializing in cloud infrastructures, web automation pipelines, and cross-functional team management..." oninput="updateResume()" rows="3" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition"></textarea>
                </div>
            </div>

            <!-- Block 2: Professional Tenure Framework -->
            <div class="space-y-4 border-t border-slate-100 pt-5">
                <h3 class="text-xs font-bold text-blue-600 tracking-wider uppercase">2. Employment History</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Company Entity</label>
                        <input type="text" id="formCompany" placeholder="Global Tech Ecosystems" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Your Role / Designation</label>
                        <input type="text" id="formRole" placeholder="Lead Engineer" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Tenure Timeline Dates</label>
                    <input type="text" id="formExpDates" placeholder="March 2022 - Present" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition w-2/3">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Responsibilities & Tangible Metrics achieved</label>
                    <textarea id="formJobDesc" placeholder="• Directed deployment of multi-region AWS configurations saving 20% overhead costs.&#10;• Mentored a high-performing group of 8 core infrastructure developers.&#10;• Rewrote legacy application logic using modern asynchronous paradigms." oninput="updateResume()" rows="4" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition font-mono text-xs text-slate-700"></textarea>
                </div>
            </div>

            <!-- Block 3: Academic Profile Infrastructure -->
            <div class="space-y-4 border-t border-slate-100 pt-5">
                <h3 class="text-xs font-bold text-blue-600 tracking-wider uppercase">3. Academic Profile</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Academic Institution</label>
                        <input type="text" id="formSchool" placeholder="University of California" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Degree Earned / Discipline</label>
                        <input type="text" id="formDegree" placeholder="M.S. in Software Systems Engineering" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Graduation Date or Year</label>
                    <input type="text" id="formEduDates" placeholder="Class of 2021" oninput="updateResume()" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-500 transition w-1/2">
                </div>
            </div>

            <!-- Block 4: Skills Array Processing -->
            <div class="space-y-4 border-t border-slate-100 pt-5">
                <h3 class="text-xs font-bold text-blue-600 tracking-wider uppercase">4. Core Skills Inventory</h3>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Skills (Separate elements with a comma)</label>
