<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional Resume Creator Profile</title>
    <!-- Modern Tailwind CSS Delivery Engine -->
    <script src="https://jsdelivr.net"></script>
</head>
<body class="bg-slate-50 min-h-screen font-sans antialiased text-slate-900">

    <!-- Top Core Application Navigation Navbar Header -->
    <nav class="bg-slate-900 text-white border-b border-slate-800 px-6 py-4 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <span class="text-2xl">📄</span>
                <div>
                    <h1 class="text-lg font-bold tracking-tight leading-none text-white">Application Profile Canvas</h1>
                    <p class="text-xs text-slate-400 mt-1">Static Semantic Form Entry Layout Framework</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button type="submit" form="resumeForm" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-5 py-2.5 rounded-lg transition duration-200 shadow-sm active:scale-98 cursor-pointer flex items-center gap-2">
                    Submit Form Parameters
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Entry Workspace Framework Layout Wrapper -->
    <main class="max-w-4xl mx-auto my-10 px-4">
        
        <!-- Native Pure Form Element Container Linkage Target -->
        <form id="resumeForm" method="POST" action="#" class="bg-white p-8 rounded-xl border border-slate-200 shadow-xs space-y-8">
            
            <header class="border-b border-slate-100 pb-4">
                <h2 class="text-slate-800 text-lg font-bold tracking-tight">Create Professional Summary Profile</h2>
                <p class="text-slate-500 text-xs mt-0.5">Fill out your foundational background records down below to compile your dossier.</p>
            </header>

            
            <section class="space-y-4">
                <h3 class="text-xs font-bold text-blue-600 tracking-wider uppercase border-l-2 border-blue-600 pl-2">1. Personal Coordinates</h3>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="fullName" class="block text-xs font-semibold text-slate-600 mb-1">Full Legal Name</label>
                        <input type="text" id="fullName" name="fullName" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                    <div>
                        <label for="jobTitle" class="block text-xs font-semibold text-slate-600 mb-1">Target Professional Designation</label>
                        <input type="text" id="jobTitle" name="jobTitle" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label for="userEmail" class="block text-xs font-semibold text-slate-600 mb-1">Email Address</label>
                        <input type="email" id="userEmail" name="userEmail" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                    <div>
                        <label for="userPhone" class="block text-xs font-semibold text-slate-600 mb-1">Contact Phone Number</label>
                        <input type="text" id="userPhone" name="userPhone" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                    <div>
                        <label for="userLocation" class="block text-xs font-semibold text-slate-600 mb-1">Geographic Location</label>
                        <input type="text" id="userLocation" name="userLocation" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                </div>
            </section>

            <!-- Block 2: Professional Industry Experience Section -->
            <section class="space-y-4 border-t border-slate-100 pt-6">
                <h3 class="text-xs font-bold text-blue-600 tracking-wider uppercase border-l-2 border-blue-600 pl-2">2. Career Experience Parameters</h3>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="companyName" class="block text-xs font-semibold text-slate-600 mb-1">Current/Most Recent Company Entity</label>
                        <input type="text" id="companyName" name="companyName" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Core Professional Strengths</label>
                        <input type="text" id="coreStrength" name="coreStrength" required placeholder="Project Execution, Cloud Migration, etc." class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="totalExperience" class="block text-xs font-semibold text-slate-600 mb-1">Total Years in Active Field</label>
                        <input type="text" id="totalExperience" name="totalExperience" required placeholder="e.g., 5+ Years" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                    <div>
                        <label for="majorAchievement" class="block text-xs font-semibold text-slate-600 mb-1">Primary Deliverable Achievement Milestone</label>
                        <input type="text" id="majorAchievement" name="majorAchievement" required placeholder="e.g., Optimized layout loading speeds by 40%" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                </div>
            </section>

            <!-- Block 3: Academic/Instructional Section -->
            <section class="space-y-4 border-t border-slate-100 pt-6">
                <h3 class="text-xs font-bold text-blue-600 tracking-wider uppercase border-l-2 border-blue-600 pl-2">3. Intellectual Background</h3>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="degreeMajor" class="block text-xs font-semibold text-slate-600 mb-1">Highest Degree / Course Specialization</label>
                        <input type="text" id="degreeMajor" name="degreeMajor" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                    <div>
                        <label for="technicalSkills" class="block text-xs font-semibold text-slate-600 mb-1">Primary Tools & Core Competencies</label>
                        <input type="text" id="technicalSkills" name="technicalSkills" required placeholder="React, Python, AWS, Git" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-hidden focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
                    </div>
                </div>
            </section>

            <!-- Submission Area Segment -->
            <footer class="border-t border-slate-100 pt-6 flex justify-end">
                <button type="submit" class="bg-slate-900 text-white font-semibold text-sm px-6 py-3 rounded-lg hover:bg-slate-800 transition duration-150 active:scale-98 shadow-sm cursor-pointer">
                    Compile Professional Profile Summary
                </button>
            </footer>

        </form>
    </main>

</body>
</html>
